    },
    {
      "old": "factions/external.html",
      "new": "factions/index.html#other-powers"
    }
  ],
  "allow": [
    "prime/cosmology/:outcomes were undecided|new undecided things"
  ],
  "scan": [
    "prime",
    "restricted"
  ]
}
