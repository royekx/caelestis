{
  "about": "Read by scripts/terms.js. 'retired' terms must not appear on DM pages once their section is finished; 'voice' patterns mark decision voice or placeholders on world pages; 'moved' lists old page paths that must not be linked. 'scan' lists the top folders read; 'finished' lists the folders whose hits fail the check; everything else is reported as a warning. 'allow' holds 'path:regex' pairs for legitimate uses.",
  "finished": [
    "prime/cosmology",
    "prime/glossary",
    "prime/factions",
    "prime/locations",
    "prime/artifacts",
    "prime/vessels"
  ],
  "retired": [
    {
      "pattern": "\\bLich Vecna\\b",
      "use": "Vecna (Lich)"
    },
    {
      "pattern": "\\b(crystal )?spheres?\\b",
      "use": "galaxy / galaxies (a region of space); keep 'sphere' only for a shape"
    },
    {
      "pattern": "\\bSPH-0\\d\\b",
      "use": "GAL-0n"
    },
    {
      "pattern": "\\bSYS-\\d+\\b",
      "use": "the system's name or CSC number (Realmspace, Krynnspace, CSC 56973)"
    },
    {
      "pattern": "\\bW-\\d{1,3}\\b",
      "use": "the world's name, or star-and-letter designation (CSC 16423 c)"
    },
    {
      "pattern": "\\bgodless\\b",
      "use": "GAL-02, the galaxy of the eldritch gods",
      "i": true
    },
    {
      "pattern": "\\bphlogiston\\b",
      "use": "the Astral Sea (the Fleet calls it the drift)",
      "i": true
    },
    {
      "pattern": "World Surveyor",
      "use": "A.T.L.A.S.",
      "i": true
    },
    {
      "pattern": "Circle of Fifteenths",
      "use": "the Circle of Fifths",
      "i": true
    },
    {
      "pattern": "\\b(four|Four) Axioms\\b",
      "use": "five Axioms"
    },
    {
      "pattern": "\\b(Boundary|Transformation|Convergence)\\b",
      "use": "Distinction / Expansion / Consolidation; the Axioms and their fragments are Consolidation, Expansion, Dissolution, Distinction, Determination"
    },
    {
      "pattern": "\\b(four|Four) fragments\\b|\\bseventeen (residue )?pieces\\b",
      "use": "five fragments, twenty-eight pieces: Dissolution 2, Distinction 3, Expansion 5, Consolidation 7, Determination 11",
      "i": true
    },
    {
      "pattern": "\\bfirst[- ]key\\b|\\bsecond key\\b|\\bkey to the First Heart\\b|\\bopens the First Heart\\b",
      "use": "a whole fragment does not open the First Heart; what assembling one does is not set (a Still to decide sentence)",
      "i": true
    },
    {
      "pattern": "\\btwo thresholds\\b",
      "use": "retired: a whole fragment does not open a door, and what all five do is not set",
      "i": true
    },
    {
      "pattern": "one person in two bodies",
      "use": "Wan and Tu, two hosts sharing one persona",
      "i": true
    },
    {
      "pattern": "\\bThe (Tyrant Ship|Tyrant|Moonraider|Flighty Foundling|Bellwether Crow)\\b",
